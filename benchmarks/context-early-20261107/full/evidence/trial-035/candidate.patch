-// Writes a decimal integer with digit grouping.
+FMT_CONSTEXPR inline void prefix_append(unsigned& prefix, unsigned value);
+
+// Writes an integer with digit grouping.
+template <unsigned BASE_BITS, typename OutputIt, typename UInt, typename Char>
+auto write_int_with_grouping(OutputIt out, UInt value, unsigned prefix,
+                             const format_specs<Char>& specs,
+                             const digit_grouping<Char>& grouping,
+                             bool upper = false) -> OutputIt {
+  int num_digits = count_digits<BASE_BITS>(value);
+  auto num_zeros = specs.precision > num_digits
+                       ? to_unsigned(specs.precision - num_digits)
+                       : 0;
+  basic_memory_buffer<char> digits;
+  digits.resize(num_zeros + to_unsigned(num_digits));
+  std::fill_n(digits.data(), num_zeros, '0');
+  format_uint<BASE_BITS>(digits.data() + num_zeros, value, num_digits, upper);
+  auto digits_size = digits.size();
+  auto size = to_unsigned((prefix >> 24) + digits_size +
+                           grouping.count_separators(to_unsigned(digits_size)));
+  return write_padded<align::right>(
+      out, specs, size, size, [&](reserve_iterator<OutputIt> it) {
+        for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+          *it++ = static_cast<Char>(p & 0xff);
+        return grouping.apply(it, string_view(digits.data(), digits_size));
+      });
+}
