+    auto abs_value = static_cast<uint64_or_128_t<T>>(arg.abs_value);
+    switch (specs.type) {
+    case presentation_type::hex_lower:
+    case presentation_type::hex_upper: {
+      bool upper = specs.type == presentation_type::hex_upper;
+      if (specs.alt)
+        prefix_append(arg.prefix, unsigned(upper ? 'X' : 'x') << 8 | '0');
+      return write_base<4>(abs_value, arg.prefix, upper);
+    }
+    case presentation_type::bin_lower:
+    case presentation_type::bin_upper: {
+      bool upper = specs.type == presentation_type::bin_upper;
+      if (specs.alt)
+        prefix_append(arg.prefix, unsigned(upper ? 'B' : 'b') << 8 | '0');
+      return write_base<1>(abs_value, arg.prefix, upper);
+    }
+    case presentation_type::oct: {
+      int num_digits = count_digits<3>(abs_value);
+      if (specs.alt && specs.precision <= num_digits && abs_value != 0)
+        prefix_append(arg.prefix, '0');
+      return write_base<3>(abs_value, arg.prefix, false);
+    }
+    default:
