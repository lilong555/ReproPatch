+  template <unsigned BASE_BITS, typename UInt>
+  auto write_base(UInt value, unsigned prefix, bool upper) -> bool {
+    int num_digits = count_digits<BASE_BITS>(value);
+    basic_memory_buffer<Char> digits;
+    if (specs.precision > num_digits)
+      detail::fill_n(appender(digits), to_unsigned(specs.precision - num_digits),
+                     static_cast<Char>('0'));
+    format_uint<BASE_BITS, Char>(appender(digits), value, num_digits, upper);
+    auto digit_group = digit_grouping<Char>(grouping, sep);
+    auto digit_size = digits.size();
+    auto size = (prefix >> 24) + digit_size +
+                digit_group.count_separators(static_cast<int>(digit_size));
+    write_padded<align::right>(
+        out, specs, size, size, [&](reserve_iterator<buffer_appender<Char>> it) {
+          for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)
+            *it++ = static_cast<Char>(p & 0xff);
+          return digit_group.apply(
+              it, basic_string_view<Char>(digits.data(), digits.size()));
+        });
+    return true;
+  }
