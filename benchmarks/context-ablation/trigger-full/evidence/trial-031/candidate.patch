@@ -423,6 +423,24 @@ class fp {
     lower.f <<= lower.e - upper.e;
     lower.e = upper.e;
   }
+
+  // Computes boundaries for a value originating from a single-precision
+  // float. The fp value is represented with double precision, so its
+  // significand step must be widened to the precision of float.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    const uint64_t float_ulp =
+        1ull << (double_significand_size -
+                 (std::numeric_limits<float>::digits - 1));
+    const bool has_shorter_lower_interval =
+        f == implicit_bit &&
+        e > std::numeric_limits<float>::min_exponent - 1 -
+                double_significand_size;
+    lower = has_shorter_lower_interval ? fp((f << 2) - float_ulp, e - 2)
+                                       : fp((f << 1) - float_ulp, e - 1);
+    upper = normalize<1>(fp((f << 1) + float_ulp, e - 1));
+    lower.f <<= lower.e - upper.e;
+    lower.e = upper.e;
+  }
 };
 
