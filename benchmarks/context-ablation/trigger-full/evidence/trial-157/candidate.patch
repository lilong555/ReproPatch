@@ -405,14 +405,96 @@ inline size_t strftime(wchar_t* str, size_t count, const wchar_t* format,
 
 FMT_END_DETAIL_NAMESPACE
 
+FMT_BEGIN_DETAIL_NAMESPACE
+
+template <typename Rep, typename Period,
+          FMT_ENABLE_IF(std::is_integral<Rep>::value)>
+long double fractional_seconds(std::chrono::duration<Rep, Period> value) {
+  auto remainder = value % std::chrono::seconds(1);
+  return std::chrono::duration<long double>(remainder).count();
+}
+
+template <typename Rep, typename Period,
+          FMT_ENABLE_IF(std::is_floating_point<Rep>::value)>
+long double fractional_seconds(std::chrono::duration<Rep, Period> value) {
+  auto seconds = std::chrono::duration<long double>(value).count();
+  return std::fmod(seconds, 1.0L);
+}
+
+template <typename Period> int fractional_seconds_precision() {
+  auto numerator = Period::num;
+  auto denominator = Period::den;
+  auto a = numerator;
+  auto b = denominator;
+  while (b != 0) {
+    auto remainder = a % b;
+    a = b;
+    b = remainder;
+  }
+  denominator /= a;
+
+  int twos = 0;
+  while (denominator % 2 == 0 && denominator > 0) {
+    denominator /= 2;
+    ++twos;
+  }
+  int fives = 0;
+  while (denominator % 5 == 0 && denominator > 0) {
+    denominator /= 5;
+    ++fives;
+  }
+  if (denominator != 1) return 6;
+  auto precision = twos > fives ? twos : fives;
+  return precision <= 18 ? precision : 6;
+}
+
+FMT_END_DETAIL_NAMESPACE
+
 template <typename Char, typename Duration>
 struct formatter<std::chrono::time_point<std::chrono::system_clock, Duration>,
                  Char> : formatter<std::tm, Char> {
   template <typename FormatContext>
-  auto format(std::chrono::time_point<std::chrono::system_clock> val,
