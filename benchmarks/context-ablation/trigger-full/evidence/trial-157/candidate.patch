               FormatContext& ctx) -> decltype(ctx.out()) {
-    std::tm time = localtime(val);
-    return formatter<std::tm, Char>::format(time, ctx);
+    auto time = localtime(std::chrono::time_point_cast<
+                          std::chrono::system_clock::duration>(val));
+    auto fraction = detail::fractional_seconds(val.time_since_epoch());
+    if (fraction < 0) fraction = -fraction;
+
+    auto precision =
+        detail::fractional_seconds_precision<typename Duration::period>();
+    if (precision == 0 && fraction != 0) precision = 6;
+    basic_memory_buffer<Char> fractional_part;
+    if (precision > 0) {
+      auto specs = basic_format_specs<Char>();
+      specs.precision = precision;
+      specs.type = 'f';
+      basic_memory_buffer<Char> digits;
+      detail::write<Char>(std::back_inserter(digits), fraction, specs);
+      auto begin = digits.begin();
+      if (begin != digits.end() && *begin == static_cast<Char>('0')) {
+        ++begin;
+        if (begin != digits.end() && *begin == static_cast<Char>('.')) ++begin;
+      }
+      fractional_part.append(begin, digits.end());
+    }
+
+    basic_memory_buffer<Char> format_specs;
+    auto it = this->specs.begin();
+    auto end = this->specs.end();
+    for (; it != end; ++it) {
+      format_specs.push_back(*it);
+      if (*it != '%' || it + 1 == end) continue;
+      ++it;
+      format_specs.push_back(*it);
+      if ((*it == 'S' || *it == 'T') && fractional_part.size() != 0)
+        format_specs.append(fractional_part.begin(), fractional_part.end());
+    }
+
+    formatter<std::tm, Char> tm_formatter;
+    tm_formatter.specs = basic_string_view<Char>(format_specs.data(),
+                                                 format_specs.size());
+    return tm_formatter.format(time, ctx);
   }
 };
 
