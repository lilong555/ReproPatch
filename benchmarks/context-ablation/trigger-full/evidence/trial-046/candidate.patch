+  // Computes boundaries for a single-precision value represented as a double.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    // A float has 24 significant bits, while fp uses the 53-bit double
+    // significand. Subnormal floats have a fixed spacing of 2^-149.
+    uint64_t delta;
+    if (e < -178) {
+      delta = 1ull << (-150 - e);
+    } else {
+      delta = 1ull << 28;
+    }
+    uint64_t lower_delta = f == implicit_bit && e > -178 ? delta >> 1 : delta;
+    lower = normalize(fp(f - lower_delta, e));
+    upper = normalize(fp(f + delta, e));
+    if (lower.e < upper.e)
+      lower.f >>= upper.e - lower.e;
+    else
+      lower.f <<= lower.e - upper.e;
+    lower.e = upper.e;
+  }
 };
 
