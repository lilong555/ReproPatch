+  // Computes boundaries for a float value represented as a double. The float
+  // significand has fewer bits, so its rounding interval is wider.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    const uint64_t ulp =
+        1ULL << (double_significand_size - std::numeric_limits<float>::digits +
+                 1);
+    const bool lower_is_closer =
+        f == implicit_bit &&
+        e > std::numeric_limits<float>::min_exponent - 1 -
+                double_significand_size;
+    lower = fp((f << 1) - (lower_is_closer ? ulp >> 1 : ulp), e - 1);
+    upper = normalize<1>(fp((f << 1) + ulp, e - 1));
+    lower.f <<= lower.e - upper.e;
+    lower.e = upper.e;
+  }
 };
 
