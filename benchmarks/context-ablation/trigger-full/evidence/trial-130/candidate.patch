+  // Computes boundaries for a single-precision value represented as a double.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    // A float has 24 significant bits. Its ulp is 2^29 units of this
+    // double-precision significand for normal values, and 2^-149 for
+    // subnormal values.
+    const int ulp_shift = e < -178 ? -149 - e : 29;
+    const uint64_t upper_delta = uint64_t(1) << (ulp_shift - 1);
+    const bool lower_spacing_is_smaller = f == implicit_bit && e > -178;
+    const uint64_t lower_delta =
+        lower_spacing_is_smaller ? upper_delta >> 1 : upper_delta;
+    lower = fp(f - lower_delta, e);
+    upper = normalize(fp(f + upper_delta, e));
+    lower.f <<= lower.e - upper.e;
+    lower.e = upper.e;
+  }
 };
 
