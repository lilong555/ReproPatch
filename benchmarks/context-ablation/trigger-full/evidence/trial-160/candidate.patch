diff --git a/include/fmt/format-inl.h b/include/fmt/format-inl.h
index 30de39b26de60c5e3eea773d88bc91fb768164af..0a8c2b89b2b6190eb71b5dc2602c201bc3ea29a6 100644
--- a/include/fmt/format-inl.h
+++ b/include/fmt/format-inl.h
@@ -423,6 +423,25 @@ class fp {
     lower.f <<= lower.e - upper.e;
     lower.e = upper.e;
   }
+
+  // Computes boundaries for a single-precision value represented exactly as a
+  // double. A float has 24 significant bits, and subnormals have a fixed ulp.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    int ulp_exp = e + double_significand_size -
+                  (std::numeric_limits<float>::digits - 1);
+    if (ulp_exp < std::numeric_limits<float>::min_exponent -
+                      std::numeric_limits<float>::digits)
+      ulp_exp = std::numeric_limits<float>::min_exponent -
+                std::numeric_limits<float>::digits;
+    int lower_exp = ulp_exp - 1;
+    if (f == implicit_bit && e + double_significand_size >
+                                 std::numeric_limits<float>::min_exponent - 1)
+      --lower_exp;
+    upper = normalize(fp(f + (uint64_t(1) << (ulp_exp - 1 - e)), e));
+    lower = fp(f - (uint64_t(1) << (lower_exp - e)), e);
+    lower.f <<= lower.e - upper.e;
+    lower.e = upper.e;
+  }
 };
 
