+  // Computes boundaries for a float represented exactly as a double.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    // A float has 24 significant bits, compared with 53 for a double. For
+    // subnormals the spacing is fixed at 2^-149 instead of depending on the
+    // exponent.
+    const int shift = e < -178 ? -149 - e : 29;
+    const uint64_t half_ulp = uint64_t(1) << (shift - 1);
+    const bool power_of_two = f == implicit_bit && e > -178;
+    const uint64_t lower_delta = power_of_two ? half_ulp >> 1 : half_ulp;
+    lower = normalize(fp(f - lower_delta, e));
+    upper = normalize(fp(f + half_ulp, e));
+    lower.f <<= lower.e - upper.e;
+    lower.e = upper.e;
+  }
 };
 
