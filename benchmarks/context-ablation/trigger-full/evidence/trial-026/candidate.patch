diff --git a/include/fmt/core.h b/include/fmt/core.h
index 9db39267a3d2c2efee4bc59f32819fb53afbd8b1..8306478c33e115f314626c2753a00dddef7da173 100644
--- a/include/fmt/core.h
+++ b/include/fmt/core.h
@@ -1948,8 +1948,10 @@ template <typename Char> class specs_setter {
   FMT_CONSTEXPR void on_localized() { specs_.localized = true; }
 
   FMT_CONSTEXPR void on_zero() {
-    specs_.align = align::numeric;
-    specs_.fill[0] = Char('0');
+    if (specs_.align == align::none) {
+      specs_.align = align::numeric;
+      specs_.fill[0] = Char('0');
+    }
   }
 
   FMT_CONSTEXPR void on_width(int width) { specs_.width = width; }
diff --git a/include/fmt/format.h b/include/fmt/format.h
index 6df5d849de52fa8650441a2f8807bf588d8091e2..644a42ba092a316c5e85c08cae2b61f05571e882 100644
--- a/include/fmt/format.h
+++ b/include/fmt/format.h
@@ -1591,7 +1591,11 @@ OutputIt write_nonfinite(OutputIt out, bool isinf,
   constexpr size_t str_size = 3;
   auto sign = fspecs.sign;
   auto size = str_size + (sign ? 1 : 0);
-  return write_padded(out, specs, size, [=](reserve_iterator<OutputIt> it) {
+  auto adjusted_specs = specs;
+  if (adjusted_specs.align == align::numeric)
+    adjusted_specs.fill[0] = Char(' ');
+  return write_padded(out, adjusted_specs, size,
+                      [=](reserve_iterator<OutputIt> it) {
     if (sign) *it++ = static_cast<Char>(data::signs[sign]);
     return copy_str<Char>(str, str + str_size, it);
   });
