+  // Computes the rounding boundaries for a value originally represented as a
+  // float. The value is stored using double precision in fp, so a float ulp is
+  // 2^28 times the fp unit for normal values. Float subnormals have a fixed
+  // ulp of 2^-149.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    int shift = e + 28 < -150 ? -150 - e : 28;
+    upper = fp(f + (1ULL << shift), e);
+    // At a normal power of two above the minimum normal the lower spacing is
+    // half the upper spacing.
+    int lower_shift = shift;
+    if (f == implicit_bit && e + 52 > -126) --lower_shift;
+    lower = fp(f - (1ULL << lower_shift), e);
+  }
 };
 
