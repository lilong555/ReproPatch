+  // fp. The value itself is still stored with double precision, so a float ulp
+  // is 2^(double_significand_size - float_significand_size) fp units.
+  void compute_float_boundaries(fp& lower, fp& upper) const {
+    const int shift = double_significand_size -
+                      (std::numeric_limits<float>::digits - 1);
+    const uint64_t half_ulp = uint64_t(1) << (shift - 1);
+    const int min_normal_exp = std::numeric_limits<float>::min_exponent - 1 -
+                               double_significand_size;
+    const bool lower_spacing_is_smaller = f == implicit_bit && e > min_normal_exp;
+    lower = fp(f - (lower_spacing_is_smaller ? half_ulp / 2 : half_ulp), e);
+    upper = fp(f + half_ulp, e);
+  }
