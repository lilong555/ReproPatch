{"data":{"argv":["/bin/bash","--noprofile","--norc","-c","cat > /build/chrono-fraction.cc <<'EOF'\n#include <chrono>\n#include <fmt/chrono.h>\n#include <fmt/format.h>\n#include <iostream>\nint main() {\n  using clock = std::chrono::system_clock;\n  using ms_time = std::chrono::time_point<clock, std::chrono::milliseconds>;\n  using ns_time = std::chrono::time_point<clock, std::chrono::nanoseconds>;\n  std::cout << fmt::format(\"{:%S}|{:%T}\\n\", ms_time(std::chrono::milliseconds(1023)), ms_time(std::chrono::milliseconds(1023)));\n  std::cout << fmt::format(\"{:%S}|{:%T}\\n\", ns_time(std::chrono::seconds(1)), ns_time(std::chrono::seconds(1)));\n  std::cout << fmt::format(\"{:%S}\\n\", ns_time(std::chrono::nanoseconds(1234000000)));\n}\nEOF\nc++ -std=c++11 -I/src/include /build/chrono-fraction.cc -o /build/chrono-fraction && /build/chrono-fraction"],"changed_files":[],"cleanup_confirmed":false,"command_id":"1b9352625a7348e29c781ae1b025dac9","container_id":"37be6621db8bd77b6af07d8a19a3355bf985d1318e5ced6c5d1ea3d7040e22ab","cwd":"/build","duration_ms":395,"duration_seconds":0.3954680849999477,"error":null,"error_code":null,"exit_code":1,"finished_at":"2026-10-27T14:29:40.504788+00:00","output_truncated":false,"returncode":1,"source_after_sha256":"2239cb5dc725dd0ab6239c9645d20f65b717681c19ad2b9ed2780d6f88af27cb","source_before_sha256":"2239cb5dc725dd0ab6239c9645d20f65b717681c19ad2b9ed2780d6f88af27cb","source_manifest":{"path":"manifests/1b9352625a7348e29c781ae1b025dac9-repair.json","sha256":"994e8725487a49b9d147d667412e8a0dc41d711acbf23a411c35ded2349c1893","size_bytes":29949},"started_at":"2026-10-27T14:29:40.109309+00:00","status":"exited","stderr":"/usr/bin/ld: /tmp/ccAz2F0L.o: warning: relocation against `_ZN3fmt2v76detail10basic_dataIvE6digitsE' in read-only section `.text._ZN3fmt2v76detail14write_exponentIcPcEET0_iS4_[_ZN3fmt2v76detail14write_exponentIcPcEET0_iS4_]'\n/usr/bin/ld: /tmp/ccAz2F0L.o: in function `main':\nchrono-fraction.cc:(.text+0x119): undefined refer