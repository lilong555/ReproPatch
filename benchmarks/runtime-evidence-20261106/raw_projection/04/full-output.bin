29,  -502,  -475,  -449,  -422,  -396, -369,\n  1592\t      -343,  -316,  -289,  -263,  -236,  -210,  -183,  -157,  -130,  -103, -77,\n  1593\t      -50,   -24,   3,     30,    56,    83,    109,   136,   162,   189,  216,\n  1594\t      242,   269,   295,   322,   348,   375,   402,   428,   455,   481,  508,\n  1595\t      534,   561,   588,   614,   641,   667,   694,   720,   747,   774,  800,\n  1596\t      827,   853,   880,   907,   933,   960,   986,   1013,  1039,  1066};\n  1597\t#if FMT_GCC_VERSION && FMT_GCC_VERSION < 409\n  1598\t#  pragma GCC diagnostic pop\n  1599\t#endif\n  1600\t\n  1601\t  static constexpr uint64_t power_of_10_64[20] = {\n  1602\t      1, FMT_POWERS_OF_10(1ULL), FMT_POWERS_OF_10(1000000000ULL),\n  1603\t      10000000000000000000ULL};\n  1604\t};\n  1605\t\n  1606\t#if FMT_CPLUSPLUS < 201703L\n  1607\ttemplate <typename T> constexpr uint64_t basic_data<T>::pow10_significands[];\n  1608\ttemplate <typename T> constexpr int16_t basic_data<T>::pow10_exponents[];\n  1609\ttemplate <typename T> constexpr uint64_t basic_data<T>::power_of_10_64[];\n  1610\t#endif\n  1611\t\n  1612\t// This is a struct rather than an alias to avoid shadowing warnings in gcc.\n  1613\tstruct data : basic_data<> {};\n  1614\t\n  1615\t// Returns a cached power of 10 `c_k = c_k.f * pow(2, c_k.e)` such that its\n  1616\t// (binary) exponent satisfies `min_exponent <= c_k.e <= min_exponent + 28`.\n  1617\tFMT_CONSTEXPR inline fp get_cached_power(int min_exponent,\n  1618\t                                         int& pow10_exponent) {\n  1619\t  const int shift = 32;\n  1620\t  // log10(2) = 0x0.4d104d427de7fbcc...\n  1621\t  const int64_t significand = 0x4d104d427de7fbcc;\n  1622\t  int index = static_cast<int>(\n  1623\t      ((min_exponent + fp::num_significand_bits - 1) * (significand >> shift) +\n  1624\t       ((int64_t(1) << shift) - 1))  // ceil\n  1625\t      >> 32                          // arithmetic shift\n  1626\t  );\n  1627\t  // Decimal exponent of the first (smallest) cached power of 10.\n  1628\t  const int first_dec_exp = -348;\n  1629\t  // Difference between 2 consecutive decimal exponents in cached powers of 10.\n  1630\t  const int dec_exp_step = 8;\n  1631\t  index = (index - first_dec_exp - 1) / dec_exp_step + 1;\n  1632\t  pow10_exponent = first_dec_exp + index * dec_exp_step;\n  1633\t  // Using *(x + index) instead of x[index] avoids an issue with some compilers\n  1634\t  // using the EDG frontend (e.g. nvhpc/22.3 in C++17 mode).\n  1635\t  return {*(data::pow10_significands + index),\n  1636\t          *(data::pow10_exponents + index)};\n  1637\t}\n  1638\t\n  1639\ttemplate <typename T>\n  1640\tusing convert_float_result =\n  1641\t    conditional_t<std::is_same<T, float>::value ||\n  1642\t                      std::numeric_limits<T>::digits ==\n  1643\t                          std::numeric_limits<double>::digits,\n  1644\t                  double, T>;\n  1645\t\n  1646\ttemplate <typename T>\n  1647\tconstexpr auto convert_float(T value) -> convert_float_result<T> {\n  1648\t  return static_cast<convert_float_result<T>>(value);\n  1649\t}\n  1650\t\n  1651\ttemplate <typename OutputIt, typename Char>\n  1652\tFMT_NOINLINE FMT_CONSTEXPR auto fill(OutputIt it, size_t n,\n  1653\t                                     const fill_t<Char>& fill) -> OutputIt {\n  1654\t  auto fill_size = fill.size();\n  1655\t  if (fill_size == 1) return detail::fill_n(it, n, fill[0]);\n  1656\t  auto data = fill.data();\n  1657\t  for (size_t i = 0; i < n; ++i)\n  1658\t    it = copy_str<Char>(data, data + fill_size, it);\n  1659\t  return it;\n  1660\t}\n  1661\t\n  1662\t// Writes the output of f, padded according to format specifications in specs.\n  1663\t// size: output size in code units.\n  1664\t// width: output display width in (terminal) column positions.\n  1665\ttemplate <align::type align = align::left, typename OutputIt, typename Char,\n  1666\t          typename F>\n  1667\tFMT_CONSTEXPR auto write_padded(OutputIt out,\n  1668\t                                const basic_format_specs<Char>& specs,\n  1669\t                                size_t size, size_t width, F&& f) -> OutputIt {\n  1670\t  static_assert(align == align::left || align == align::right, \"\");\n  1671\t  unsigned spec_width = to_unsigned(specs.width);\n  1672\t  size_t padding = spec_width > width ? spec_width - width : 0;\n  1673\t  // Shifts are encoded as string literals because static constexpr is not\n  1674\t  // supported in constexpr functions.\n  1675\t  auto* shifts = align == align::left ? \"\\x1f\\x1f\\x00\\x01\" : \"\\x00\\x1f\\x00\\x01\";\n  1676\t  size_t left_padding = padding >> shifts[specs.align];\n  1677\t  size_t right_padding = padding - left_padding;\n  1678\t  auto it = reserve(out, size + padding * specs.fill.size());\n  1679\t  if (left_padding != 0) it = fill(it, left_padding, specs.fill);\n  1680\t  it = f(it);\n  1681\t  if (right_padding != 0) it = fill(it, right_padding, specs.fill);\n  1682\t  return base_iterator(out, it);\n  1683\t}\n  1684\t\n  1685\ttemplate <align::type align = align::left, typename OutputIt, typename Char,\n  1686\t          typename F>\n  1687\tconstexpr auto write_padded(OutputIt out, const basic_format_specs<Char>& specs,\n  1688\t                            size_t size, F&& f) -> OutputIt {\n  1689\t  return write_padded<align>(out, specs, size, size, f);\n  1690\t}\n  1691\t\n  1692\ttemplate <align::type align = align::left, typename Char, typename OutputIt>\n  1693\tFMT_CONSTEXPR auto write_bytes(OutputIt out, string_view bytes,\n  1694\t                               const basic_format_specs<Char>& specs)\n  1695\t    -> OutputIt {\n  1696\t  return write_padded<align>(\n  1697\t      out, specs, bytes.size(), [bytes](reserve_iterator<OutputIt> it) {\n  1698\t        const char* data = bytes.data();\n  1699\t        return copy_str<Char>(data, data + bytes.size(), it);\n  1700\t      });\n  1701\t}\n  1702\t\n  1703\ttemplate <typename Char, typename OutputIt, typename UIntPtr>\n  1704\tauto write_ptr(OutputIt out, UIntPtr value,\n  1705\t               const basic_format_specs<Char>* specs) -> OutputIt {\n  1706\t  int num_digits = count_digits<4>(value);\n  1707\t  auto size = to_unsigned(num_digits) + size_t(2);\n  1708\t  auto write = [=](reserve_iterator<OutputIt> it) {\n  1709\t    *it++ = static_cast<Char>('0');\n  1710\t    *it++ = static_cast<Char>('x');\n  1711\t    return format_uint<4, Char>(it, value, num_digits);\n  1712\t  };\n  1713\t  return specs ? write_padded<align::right>(out, *specs, size, write)\n  1714\t               : base_iterator(out, write(reserve(out, size)));\n  1715\t}\n  1716\t\n  1717\t// Returns true iff the code point cp is printable.\n  1718\tFMT_API auto is_printable(uint32_t cp) -> bool;\n  1719\t\n  1720\tinline auto needs_escape(uint32_t cp) -> bool {\n  1721\t  return cp < 0x20 || cp == 0x7f || cp == '\"' || cp == '\\\\' ||\n  1722\t         !is_printable(cp);\n  1723\t}\n  1724\t\n  1725\ttemplate <typename Char> struct find_escape_result {\n  1726\t  const Char* begin;\n  1727\t  const Char* end;\n  1728\t  uint32_t cp;\n  1729\t};\n  1730\t\n  1731\ttemplate <typename Char>\n  1732\tusing make_unsigned_char =\n  1733\t    typename conditional_t<std::is_integral<Char>::value,\n  1734\t                           std::make_unsigned<Char>,\n  1735\t                           type_identity<uint32_t>>::type;\n  1860\t}\n  1861\t\n  1862\ttemplate <typename Char, typename OutputIt>\n  1863\tauto write_escaped_char(OutputIt out, Char v) -> OutputIt {\n  1864\t  *out++ = static_cast<Char>('\\'');\n  1865\t  if ((needs_escape(static_cast<uint32_t>(v)) && v != static_cast<Char>('\"')) ||\n  1866\t      v == static_cast<Char>('\\'')) {\n  1867\t    out = write_escaped_cp(\n  1868\t        out, find_escape_result<Char>{&v, &v + 1, static_cast<uint32_t>(v)});\n  1869\t  } else {\n  1870\t    *out++ = v;\n  1871\t  }\n  1872\t  *out++ = static_cast<Char>('\\'');\n  1873\t  return out;\n  1874\t}\n  1875\t\n  1876\ttemplate <typename Char, typename OutputIt>\n  1877\tFMT_CONSTEXPR auto write_char(OutputIt out, Char value,\n  1878\t                              const basic_format_specs<Char>& specs)\n  1879\t    -> OutputIt {\n  1880\t  bool is_debug = specs.type == presentation_type::debug;\n  1881\t  return write_padded(out, specs, 1, [=](reserve_iterator<OutputIt> it) {\n  1882\t    if (is_debug) return write_escaped_char(it, value);\n  1883\t    *it++ = value;\n  1884\t    return it;\n  1885\t  });\n  1886\t}\n  1887\ttemplate <typename Char, typename OutputIt>\n  1888\tFMT_CONSTEXPR auto write(OutputIt out, Char value,\n  1889\t                         const basic_format_specs<Char>& specs,\n  1890\t                         locale_ref loc = {}) -> OutputIt {\n  1891\t  return check_char_specs(specs)\n  1892\t             ? write_char(out, value, specs)\n  1893\t             : write(out, static_cast<int>(value), specs, loc);\n  1894\t}\n  1895\t\n  1896\t// Data for write_int that doesn't depend on output iterator type. It is used to\n  1897\t// avoid template code bloat.\n  1898\ttemplate <typename Char> struct write_int_data {\n  1899\t  size_t size;\n  1900\t  size_t padding;\n  1901\t\n  1902\t  FMT_CONSTEXPR write_int_data(int num_digits, unsigned prefix,\n  1903\t                               const basic_format_specs<Char>& specs)\n  1904\t      : size((prefix >> 24) + to_unsigned(num_digits)), padding(0) {\n  1905\t    if (specs.align == align::numeric) {\n  1906\t      auto width = to_unsigned(specs.width);\n  1907\t      if (width > size) {\n  1908\t        padding = width - size;\n  1909\t        size = width;\n  1910\t      }\n  1911\t    } else if (specs.precision > num_digits) {\n  1912\t      size = (prefix >> 24) + to_unsigned(specs.precision);\n  1913\t      padding = to_unsigned(specs.precision - num_digits);\n  1914\t    }\n  1915\t  }\n  1916\t};\n  1917\t\n  1918\t// Writes an integer in the format\n  1919\t//   <left-padding><prefix><numeric-padding><digits><right-padding>\n  1920\t// where <digits> are written by write_digits(it).\n  1921\t// prefix contains chars in three lower bytes and the size in the fourth byte.\n  1922\ttemplate <typename OutputIt, typename Char, typename W>\n  1923\tFMT_CONSTEXPR FMT_INLINE auto write_int(OutputIt out, int num_digits,\n  1924\t                                        unsigned prefix,\n  1925\t                                        const basic_format_specs<Char>& specs,\n  1926\t                                        W write_digits) -> OutputIt {\n  1927\t  // Slightly faster check for specs.width == 0 && specs.precision == -1.\n  1928\t  if ((specs.width | (specs.precision + 1)) == 0) {\n  1929\t    auto it = reserve(out, to_unsigned(num_digits) + (prefix >> 24));\n  1930\t    if (prefix != 0) {\n  1931\t      for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)\n  1932\t        *it++ = static_cast<Char>(p & 0xff);\n  1933\t    }\n  1934\t    return base_iterator(out, write_digits(it));\n  1935\t  }\n  1936\t  auto data = write_int_data<Char>(num_digits, prefix, specs);\n  1937\t  return write_padded<align::right>(\n  1938\t      out, specs, data.size, [=](reserve_iterator<OutputIt> it) {\n  1939\t        for (unsigned p = prefix & 0xffffff; p != 0; p >>= 8)\n  1940\t          *it++ = static_cast<Char>(p & 0xff);\n  1941\t        it = detail::fill_n(it, data.padding, static_cast<Char>('0'));\n  1942\t        return write_digits(it);\n  1943\t      });\n  1944\t}\n  1945\t\n  1946\ttemplate <typename Char> class digit_grouping {\n  1947\t private:\n  1948\t  std::string grouping_;\n  1949\t  std::basic_string<Char> thousands_sep_;\n  1950\t\n  1951\t  struct next_state {\n  1952\t    std::string::const_iterator group;\n  1953\t    int pos;\n  1954\t  };\n  1955\t  next_state initial_state() const { return {grouping_.begin(), 0}; }\n  1956\t\n  1957\t  // Returns the next digit group separator position.\n  1958\t  int next(next_state& state) const {\n  1959\t    if (thousands_sep_.empty()) return max_value<int>();\n  1960\t    if (state.group == grouping_.end()) return state.pos += grouping_.back();\n  1961\t    if (*state.group <= 0 || *state.group == max_value<char>())\n  1962\t      return max_value<int>();\n  1963\t    state.pos += *state.group++;\n  1964\t    return state.pos;\n  1965\t  }\n  2250\t\n  2251\ttemplate <typename Char, typename OutputIt, typename T,\n  2252\t          FMT_ENABLE_IF(is_integral<T>::value &&\n  2253\t                        !std::is_same<T, bool>::value &&\n  2254\t                        !std::is_same<T, Char>::value)>\n  2255\tFMT_CONSTEXPR auto write(OutputIt out, T value) -> OutputIt {\n  2256\t  auto abs_value = static_cast<uint32_or_64_or_128_t<T>>(value);\n  2257\t  bool negative = is_negative(value);\n  2258\t  // Don't do -abs_value since it trips unsigned-integer-overflow sanitizer.\n  2259\t  if (negative) abs_value = ~abs_value + 1;\n  2260\t  int num_digits = count_digits(abs_value);\n  2261\t  auto size = (negative ? 1 : 0) + static_cast<size_t>(num_digits);\n  2262\t  auto it = reserve(out, size);\n  2263\t  if (auto ptr = to_pointer<Char>(it, size)) {\n  2264\t    if (negative) *ptr++ = static_cast<Char>('-');\n  2265\t    format_decimal<Char>(ptr, abs_value, num_digits);\n  2266\t    return out;\n  2267\t  }\n  2268\t  if (negative) *it++ = static_cast<Char>('-');\n  2269\t  it = format_decimal<Char>(it, abs_value, num_digits).end;\n  2270\t  return base_iterator(out, it);\n  2271\t}\n  2272\t\n  2273\ttemplate <typename Char, typename OutputIt>\n  2274\tFMT_CONSTEXPR20 auto write_nonfinite(OutputIt out, bool isnan,\n  2275\t                                     basic_format_specs<Char> specs,\n  2276\t                                     const float_specs& fspecs) -> OutputIt {\n  2277\t  auto str =\n  2278\t      isnan ? (fspecs.upper ? \"NAN\" : \"nan\") : (fspecs.upper ? \"INF\" : \"inf\");\n  2279\t  constexpr size_t str_size = 3;\n  2280\t  auto sign = fspecs.sign;\n  2281\t  auto size = str_size + (sign ? 1 : 0);\n  2282\t  // Replace '0'-padding with space for non-finite values.\n  2283\t  const bool is_zero_fill =\n  2284\t      specs.fill.size() == 1 && *specs.fill.data() == static_cast<Char>('0');\n  2285\t  if (is_zero_fill) specs.fill[0] = static_cast<Char>(' ');\n  2286\t  return write_padded(out, specs, size, [=](reserve_iterator<OutputIt> it) {\n  2287\t    if (sign) *it++ = detail::sign<Char>(sign);\n  2288\t    return copy_str<Char>(str, str + str_size, it);\n  2289\t  });\n  2290\t}\n  2291\t\n  2292\t// A decimal floating-point number significand * pow(10, exp).\n  2293\tstruct big_decimal_fp {\n  2294\t  const char* significand;\n  2295\t  int significand_size;\n  2296\t  int exponent;\n  2297\t};\n  2298\t\n  2299\tconstexpr auto get_significand_size(const big_decimal_fp& f) -> int {\n  2300\t  return f.significand_size;\n  2301\t}\n  2302\ttemplate <typename T>\n  2303\tinline auto get_significand_size(const dragonbox::decimal_fp<T>& f) -> int {\n  2304\t  return count_digits(f.significand);\n  2305\t}\n  2306\t\n  2307\ttemplate <typename Char, typename OutputIt>\n  2308\tconstexpr auto write_significand(OutputIt out, const char* significand,\n  2309\t                                 int significand_size) -> OutputIt {\n  2310\t  return copy_str<Char>(significand, significand + significand_size, out);\n  2410\t      fspecs.locale ? detail::decimal_point<Char>(loc) : static_cast<Char>('.');\n  2411\t\n  2412\t  int output_exp = f.exponent + significand_size - 1;\n  2413\t  auto use_exp_format = [=]() {\n  2414\t    if (fspecs.format == float_format::exp) return true;\n  2415\t    if (fspecs.format != float_format::general) return false;\n  2416\t    // Use the fixed notation if the exponent is in [exp_lower, exp_upper),\n  2417\t    // e.g. 0.0001 instead of 1e-04. Otherwise use the exponent notation.\n  2418\t    const int exp_lower = -4, exp_upper = 16;\n  2419\t    return output_exp < exp_lower ||\n  2420\t           output_exp >= (fspecs.precision > 0 ? fspecs.precision : exp_upper);\n  2421\t  };\n  2422\t  if (use_exp_format()) {\n  2423\t    int num_zeros = 0;\n  2424\t    if (fspecs.showpoint) {\n  2425\t      num_zeros = fspecs.precision - significand_size;\n  2426\t      if (num_zeros < 0) num_zeros = 0;\n  2427\t      size += to_unsigned(num_zeros);\n  2428\t    } else if (significand_size == 1) {\n  2429\t      decimal_point = Char();\n  2430\t    }\n  2431\t    auto abs_output_exp = output_exp >= 0 ? output_exp : -output_exp;\n  2432\t    int exp_digits = 2;\n  2433\t    if (abs_output_exp >= 100) exp_digits = abs_output_exp >= 1000 ? 4 : 3;\n  2434\t\n  2435\t    size += to_unsigned((decimal_point ? 1 : 0) + 2 + exp_digits);\n  2436\t    char exp_char = fspecs.upper ? 'E' : 'e';\n  2437\t    auto write = [=](iterator it) {\n  2438\t      if (sign) *it++ = detail::sign<Char>(sign);\n  2439\t      // Insert a decimal point after the first digit and add an exponent.\n  2440\t      it = write_significand(it, significand, significand_size, 1,\n  2441\t                             decimal_point);\n  2442\t      if (num_zeros > 0) it = detail::fill_n(it, num_zeros, zero);\n  2443\t      *it++ = static_cast<Char>(exp_char);\n  2444\t      return write_exponent<Char>(output_exp, it);\n  2445\t    };\n  2446\t    return specs.width > 0 ? write_padded<align::right>(out, specs, size, write)\n  2447\t                           : base_iterator(out, write(reserve(out, size)));\n  2448\t  }\n  2449\t\n  2450\t  int exp = f.exponent + significand_size;\n  2451\t  if (f.exponent >= 0) {\n  2452\t    // 1234e5 -> 123400000[.0+]\n  2453\t    size += to_unsigned(f.exponent);\n  2454\t    int num_zeros = fspecs.precision - exp;\n  2455\t    abort_fuzzing_if(num_zeros > 5000);\n  2456\t    if (fspecs.showpoint) {\n  2457\t      ++size;\n  2458\t      if (num_zeros <= 0 && fspecs.format != float_format::fixed) num_zeros = 1;\n  2459\t      if (num_zeros > 0) size += to_unsigned(num_zeros);\n  2460\t    }\n  2461\t    auto grouping = Grouping(loc, fspecs.locale);\n  2462\t    size += to_unsigned(grouping.count_separators(exp));\n  2463\t    return write_padded<align::right>(out, specs, size, [&](iterator it) {\n  2464\t      if (sign) *it++ = detail::sign<Char>(sign);\n  2465\t      it = write_significand<Char>(it, significand, significand_size,\n  2466\t                                   f.exponent, grouping);\n  2467\t      if (!fspecs.showpoint) return it;\n  2468\t      *it++ = decimal_point;\n  2469\t      return num_zeros > 0 ? detail::fill_n(it, num_zeros, zero) : it;\n  2470\t    });\n  2471\t  } else if (exp > 0) {\n  2472\t    // 1234e-2 -> 12.34[0+]\n  2473\t    int num_zeros = fspecs.showpoint ? fspecs.precision - significand_size : 0;\n  2474\t    size += 1 + to_unsigned(num_zeros > 0 ? num_zeros : 0);\n  2475\t    auto grouping = Grouping(loc, fspecs.locale);\n  2476\t    size += to_unsigned(grouping.count_separators(significand_size));\n  2477\t    return write_padded<align::right>(out, specs, size, [&](iterator it) {\n  2478\t      if (sign) *it++ = detail::sign<Char>(sign);\n  2479\t      it = write_significand(it, significand, significand_size, exp,\n  2480\t                             decimal_point, grouping);\n  2481\t      return num_zeros > 0 ? detail::fill_n(it, num_zeros, zero) : it;\n  2482\t    });\n  2483\t  }\n  2484\t  // 1234e-6 -> 0.001234\n  2485\t  int num_zeros = -exp;\n  2486\t  if (significand_size == 0 && fspecs.precision >= 0 &&\n  2487\t      fspecs.precision < num_zeros) {\n  2488\t    num_zeros = fspecs.precision;\n  2489\t  }\n  2490\t  bool pointy = num_zeros != 0 || significand_size != 0 || fspecs.showpoint;\n  2491\t  size += 1 + (pointy ? 1 : 0) + to_unsigned(num_zeros);\n  2492\t  return write_padded<align::right>(out, specs, size, [&](iterator it) {\n  2493\t    if (sign) *it++ = detail::sign<Char>(sign);\n  2494\t    *it++ = zero;\n  2495\t    if (!pointy) return it;\n  2496\t    *it++ = decimal_point;\n  2497\t    it = detail::fill_n(it, num_zeros, zero);\n  2498\t    return write_significand<Char>(it, significand, significand_size);\n  2499\t  });\n  2500\t}\n  2501\t\n  2502\ttemplate <typename Char> class fallback_digit_grouping {\n  2503\t public:\n  2504\t  constexpr fallback_digit_grouping(locale_ref, bool) {}\n  2505\t\n  2506\t  constexpr bool has_separator() const { return false; }\n  2507\t\n  2508\t  constexpr int count_separators(int) const { return 0; }\n  2509\t\n  2510\t  template <typename Out, typename C>\n  3290\t    format_dragon(f, dragon_flags, precision, buf, exp);\n  3291\t  }\n  3292\t  if (!fixed && !specs.showpoint) {\n  3293\t    // Remove trailing zeros.\n  3294\t    auto num_digits = buf.size();\n  3295\t    while (num_digits > 0 && buf[num_digits - 1] == '0') {\n  3296\t      --num_digits;\n  3297\t      ++exp;\n  3298\t    }\n  3299\t    buf.try_resize(num_digits);\n  3300\t  }\n  3301\t  return exp;\n  3302\t}\n  3303\ttemplate <typename Char, typename OutputIt, typename T>\n  3304\tFMT_CONSTEXPR20 auto write_float(OutputIt out, T value,\n  3305\t                                 basic_format_specs<Char> specs, locale_ref loc)\n  3306\t    -> OutputIt {\n  3307\t  float_specs fspecs = parse_float_type_spec(specs);\n  3308\t  fspecs.sign = specs.sign;\n  3309\t  if (detail::signbit(value)) {  // value < 0 is false for NaN so use signbit.\n  3310\t    fspecs.sign = sign::minus;\n  3311\t    value = -value;\n  3312\t  } else if (fspecs.sign == sign::minus) {\n  3313\t    fspecs.sign = sign::none;\n  3314\t  }\n  3315\t\n  3316\t  if (!detail::isfinite(value))\n  3317\t    return write_nonfinite(out, detail::isnan(value), specs, fspecs);\n  3318\t\n  3319\t  if (specs.align == align::numeric && fspecs.sign) {\n  3320\t    auto it = reserve(out, 1);\n  3321\t    *it++ = detail::sign<Char>(fspecs.sign);\n  3322\t    out = base_iterator(out, it);\n  3323\t    fspecs.sign = sign::none;\n  3324\t    if (specs.width != 0) --specs.width;\n  3325\t  }\n  3326\t\n  3327\t  memory_buffer buffer;\n  3328\t  if (fspecs.format == float_format::hex) {\n  3329\t    if (fspecs.sign) buffer.push_back(detail::sign<char>(fspecs.sign));\n  3330\t    format_hexfloat(convert_float(value), specs.precision, fspecs, buffer);\n  3331\t    return write_bytes<align::right>(out, {buffer.data(), buffer.size()},\n  3332\t                                     specs);\n  3333\t  }\n  3334\t  int precision = specs.precision >= 0 || specs.type == presentation_type::none\n  3335\t                      ? specs.precision\n  3336\t                      : 6;\n  3337\t  if (fspecs.format == float_format::exp) {\n  3338\t    if (precision == max_value<int>())\n  3339\t      throw_format_error(\"number is too big\");\n  3340\t    else\n  3341\t      ++precision;\n  3342\t  } else if (fspecs.format != float_format::fixed && precision == 0) {\n  3343\t    precision = 1;\n  3344\t  }\n  3345\t  if (const_check(std::is_same<T, float>())) fspecs.binary32 = true;\n  3346\t  int exp = format_float(convert_float(value), precision, fspecs, buffer);\n  3347\t  fspecs.precision = precision;\n  3348\t  auto f = big_decimal_fp{buffer.data(), static_cast<int>(buffer.size()), exp};\n  3349\t  return write_float(out, f, specs, fspecs, loc);\n  3350\t}\n","stdout_bytes":25118,"stdout_log":{"path":"logs/805b12095f8c42f8b64223b6755f82c3/stdout.bin","sha256":"b5db00064f4dabf54db73188078ee987299b08bfb3d9500c85da8516d83104f9","size_bytes":25118},"timed_out":false,"truncated":false},"ok":true,"progress":{"agent_seconds_remaining":5882,"model_steps_remaining":21,"pending_tool_calls":0,"source_changed":false,"tool_calls_remaining":45}}